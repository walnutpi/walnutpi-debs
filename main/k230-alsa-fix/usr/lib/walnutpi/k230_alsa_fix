#!/bin/bash
#
# K230 ALSA 音量初始化脚本
# 开机时设置 PCM 音量为 73%
#

set -e

# 等待 ALSA 设备就绪（无限等待）
while ! amixer -c 0 info &>/dev/null; do
    sleep 1
done

# 设置 PCM 音量
if amixer -c 0 contents | grep -q "name='PCM'"; then
    amixer -c 0 set 'PCM' 73%
    echo "k230-alsa-fix: set PCM volume to 73%"
else
    echo "k230-alsa-fix: PCM control not found, skipping"
fi

exit 0
