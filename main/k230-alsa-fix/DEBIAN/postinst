#!/bin/bash

set -e

SERVICE_NAME="k230-alsa-fix.service"

ALSACTL_PATH="/usr/sbin/alsactl"
BACKUP_PATH="/usr/sbin/alsactl.backup"

case "$1" in
    configure)
        # --- 服务管理 ---
        # Enable and start the service
        if [ -d /run/systemd/system ]; then
            deb-systemd-helper unmask "$SERVICE_NAME" >/dev/null || true
            deb-systemd-helper enable "$SERVICE_NAME" >/dev/null || true
            deb-systemd-helper start "$SERVICE_NAME" >/dev/null || true
        fi

        # --- alsactl 屏蔽 ---
        if [ -f "$ALSACTL_PATH" ]; then
            echo "Found $ALSACTL_PATH, backing up to $BACKUP_PATH"
            mv "$ALSACTL_PATH" "$BACKUP_PATH"
            touch "$ALSACTL_PATH"
            chmod +x "$ALSACTL_PATH"
            echo "Successfully backed up and masked $ALSACTL_PATH"
        else
            echo "File $ALSACTL_PATH does not exist, nothing to backup"
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst: unknown command '$1'"
        exit 1
        ;;
esac

exit 0