#!/bin/bash
set -e  # 遇到错误立即退出

# 定义颜色输出
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

# 检查必要命令是否存在
check_dependencies() {
    if ! command -v pip3 &> /dev/null; then
        log_error "pip3 is not installed. Please install python3-pip package."
        exit 1
    fi
    
    if ! command -v python3 &> /dev/null; then
        log_error "python3 is not installed."
        exit 1
    fi
}

# 安装模式：首次安装
install_package() {
    log_info "Installing walnutpi.imgxfer package..."
    
    cd /usr/lib/walnutpi || { 
        log_error "Directory /usr/lib/walnutpi does not exist"
        exit 1
    }
    
    if [ -d "walnutpi.imgxfer/" ]; then
        log_info "Installing walnutpi.imgxfer in development mode..."
        if pip3 install --no-cache-dir --break-system-packages -e walnutpi.imgxfer/; then
            log_info "walnutpi.imgxfer package installed successfully"
        else
            log_error "Failed to install walnutpi.imgxfer package"
            exit 1
        fi
    else
        log_error "walnutpi.imgxfer directory does not exist in /usr/lib/walnutpi/"
        exit 1
    fi
}

# 升级模式：更新已安装的包
upgrade_package() {
    log_info "Upgrading walnutpi.imgxfer package..."
    
    cd /usr/lib/walnutpi || { 
        log_error "Directory /usr/lib/walnutpi does not exist"
        exit 1
    }
    
    if [ -d "walnutpi.imgxfer/" ]; then
        log_info "Reinstalling/updating walnutpi.imgxfer in development mode..."
        if pip3 install --no-cache-dir --force-reinstall -e walnutpi.imgxfer/; then
            log_info "walnutpi.imgxfer package upgraded successfully"
        else
            log_error "Failed to upgrade walnutpi.imgxfer package"
            exit 1
        fi
    else
        log_error "walnutpi.imgxfer directory does not exist in /usr/lib/walnutpi/"
        exit 1
    fi
}

# 配置模式：重新配置包
configure_package() {
    log_info "Configuring walnutpi.imgxfer package..."
    # 如果有额外的配置步骤，可以在这里添加
    # 比如设置权限、创建软链接等
}

main() {
    check_dependencies
    
    case "$1" in
        configure)
            if [ -z "$2" ]; then
                # 首次安装
                install_package
            else
                # 升级场景 (old version provided as second argument)
                upgrade_package
            fi
            configure_package
            ;;
        abort-upgrade|abort-remove|abort-deconfigure)
            log_warn "Package operation $1 was aborted, but continuing with configuration"
            configure_package
            ;;
        *)
            log_warn "Unknown parameter: $1, proceeding with default installation"
            install_package
            ;;
    esac
    
    log_info "Post-installation script completed successfully"
}

main "$@"