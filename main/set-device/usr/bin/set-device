#!/bin/bash

# 检测当前执行这个脚本时是否具有root权限，没有则退出
if [ $(id -u) -ne 0 ]; then
    echo "Please run as root"
    exit 1
fi

# 在构建镜像的场景下可能没有 /boot/config.txt，静默退出
if [ ! -f /boot/config.txt ]; then
    exit 0
fi

prefix=$(grep "^overlay_prefix=" /boot/config.txt | cut -d'=' -f2)
DTB_NAME=$(grep "^fdtfile=" /boot/config.txt | cut -d'=' -f2)

# 检测 DTB 是否被旧版 set-device 覆盖过（含 /flag/set-device 标记）
# 正常情况下 postinst 已处理迁移，这里做二次防御
if [ -n "$DTB_NAME" ] && [ -f "/boot/$DTB_NAME.dtb" ]; then
    if fdtget -p "/boot/$DTB_NAME.dtb" /flag >/dev/null 2>&1; then
        echo "WARNING: /boot/$DTB_NAME.dtb appears to have been modified by old set-device."
        echo "The base DTB may contain stale overlay data. Please reinstall the system DTB."
    fi
fi

# 确保 fdtfile 以 overlays- 开头
if [[ ! "$DTB_NAME" == overlays-* ]]; then
    DTB_BASE_NAME="$DTB_NAME"
    sed -i "s/^fdtfile=${DTB_NAME}/fdtfile=overlays-${DTB_NAME}/" /boot/config.txt
    DTB_NAME="overlays-${DTB_NAME}"
else
    # 从 overlays-xxx 还原原始名称 xxx
    DTB_BASE_NAME="${DTB_NAME#overlays-}"
fi

PATH_DTB_ORIG="/boot/$DTB_BASE_NAME.dtb"
PATH_DTB_OUT="/boot/$DTB_NAME.dtb"

# 扫描所有可用的 dtbo
dtbo_list=()
for file in /boot/overlays/"$prefix"-*.dtbo; do
    dtbo_list+=($(basename "$file" .dtbo | sed "s/^$prefix-//"))
done

_has_dtbo() {
    local name=$1
    if [[ " ${dtbo_list[*]} " == *" $1 "* ]]; then
        return 0
    else
        return 1
    fi
}
_is_dtbo_enabled() {
    local name=$1
    local overlays=$(grep "^overlays=" /boot/config.txt | cut -d'=' -f2)
    if [[ $overlays =~ (^|[[:space:]])"$1"($|[[:space:]]) ]]; then
        return 0
    else
        return 1
    fi
}
# 传入一个名字，输出该设备状态
_show_status() {
    local name=$1
    
    _is_dtbo_enabled $name
    if [ $? -eq 0 ]; then
        echo -en "\033[32m"
    else
        echo -en "\033[31m"
    fi
    
    _is_dtbo_enabled $name
    if [ $? -eq 0 ]; then
        echo -en "<enable>"
    else
        echo -en "<  off >"
    fi
    
    echo -en " $name"
    echo -e "\033[0m"
}

# 如果有参数1，则显示该设备状态
# 如果没有参数1，则显示所有设备状态
status() {
    echo -e "\n-------------------------"
    if [ ! -z "$1" ]; then
        _has_dtbo $1
        if [ $? -eq 0 ]; then
            _show_status $1
        fi
    else
        for d in "${dtbo_list[@]}"; do
            _show_status $d
        done
    fi
    echo -e "-------------------------\n"
}
enable() {
    local dtbo_name="$1"
    if [ ! -z "$dtbo_name" ]; then
        _has_dtbo $dtbo_name
        if [ $? -ne 0 ]; then
            echo "device name error"
            exit 1
        fi
    else
        echo "please choose device"
        exit -1
    fi
    
    _is_dtbo_enabled $dtbo_name
    if [ ! $? -eq 0 ]; then
        echo -e "enable: $dtbo_name"
        sed -i "/^overlays=/ s/$/ $dtbo_name/" /boot/config.txt
    fi
    
}
disable() {
    local dtbo_name="$1"
    if [ ! -z "$dtbo_name" ]; then
        _has_dtbo $dtbo_name
        if [ $? -ne 0 ]; then
            echo "device name error"
            exit 1
        fi
    else
        echo "please choose device"
        exit -1
    fi
    
    _is_dtbo_enabled $dtbo_name
    if [ $? -eq 0 ]; then
        echo -e "disable: $dtbo_name"
        sed -i "/^overlays=/ s/\<$dtbo_name\>//" /boot/config.txt
    fi
    
}

FUNCTION_NAME=$1
DTB_NAME=$2
$FUNCTION_NAME $DTB_NAME


# 重新读取可能被 enable/disable 修改后的 fdtfile
DTB_NAME=$(grep "^fdtfile=" /boot/config.txt | cut -d'=' -f2)
if [[ "$DTB_NAME" == overlays-* ]]; then
    DTB_BASE_NAME="${DTB_NAME#overlays-}"
else
    DTB_BASE_NAME="$DTB_NAME"
fi
PATH_DTB_ORIG="/boot/$DTB_BASE_NAME.dtb"
PATH_DTB_OUT="/boot/$DTB_NAME.dtb"

# 根据 overlays 合并生成设备树文件
dtbo_files=""
for name in $(grep "^overlays=" /boot/config.txt | cut -d'=' -f2); do
    dtbo_file="/boot/overlays/$prefix-$name.dtbo"
    if [ -f "$dtbo_file" ]; then
        dtbo_files="$dtbo_files $dtbo_file"
    fi
done

if [ -z "$dtbo_files" ]; then
    cp "$PATH_DTB_ORIG" "$PATH_DTB_OUT"
else
    fdtoverlay -i "$PATH_DTB_ORIG" $dtbo_files -o "$PATH_DTB_OUT"
fi
