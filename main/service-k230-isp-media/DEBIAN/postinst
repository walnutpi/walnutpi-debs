#!/bin/bash
set -e

case "$1" in
configure)
    # 安装或升级时启用并启动服务
    systemctl enable isp_media_server.service || exit 1

    cd /usr/lib/walnutpi/vvcam-lib
    make -j $(nproc) clean all install

    # 如果之前没有运行或者是在升级，重启服务以应用新配置
    if [ "$2" = "" ] || [ -n "$2" ]; then
        if systemctl is-active --quiet isp_media_server.service; then
            systemctl reload-or-restart isp_media_server.service
        else
            systemctl start isp_media_server.service
        fi
    fi

    ;;
abort-upgrade | abort-remove | abort-deconfigure)
    # 处理安装中断情况
    echo "Installation/upgrade aborted: $1" >&2
    exit 0
    ;;
*)
    echo "postinst called with unknown argument: $1" >&2
    exit 1
    ;;
esac

exit 0
